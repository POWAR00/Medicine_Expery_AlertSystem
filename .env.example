# Copy to .env for local runs; on Render set these in the dashboard (Never commit real values)
SECRET_KEY=replace-with-a-long-random-string

# PRODUCTION (Render blocks outbound SMTP, so use this HTTPS path)
# Free plan: 300 emails/day -> https://login.brevo.com
BREVO_API_KEY=your-brevo-smtp-api-key
EMAIL_SENDER=verified-sender@example.com

# LOCAL DEV only (Gmail app password over SMTP; not usable on Render)
SMTP_EMAIL=your-sender@gmail.com
SMTP_PASSWORD=your-16-char-google-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
